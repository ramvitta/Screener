# Definedge Securities API credentials
DEFINEDGE_API_TOKEN=
DEFINEDGE_API_SECRET=
# External TOTP secret (enable at https://myaccount.definedgesecurities.com/security).
# When set, login bypasses the manual OTP prompt/endpoint and generates the
# 6-digit code from this secret instead.
DEFINEDGE_TOTP_SECRET=

# ClickHouse connection
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
# Required — docker-compose refuses to start without it. Use a long random value.
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=options_platform

# SQLite
SQLITE_PATH=./data/app.db

# Screener
NIFTY_MONEYNESS_BAND_PCT=15
SCREENER_INTERVAL_MINUTES=5

# --- Security (see IMPLEMENTATION_PLAN.md) ---
# Static bearer token required on every API/WebSocket call. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=
# Fernet key used to encrypt broker session keys at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, session keys are NOT persisted (a restart triggers a fresh TOTP login).
SESSION_ENCRYPTION_KEY=
# Order placement is hard-disabled. Leave as 'disabled'.
TRADING_MODE=disabled
# Dev only: allow signals from the hardcoded sample chain when no live data exists.
ALLOW_SAMPLE_DATA=false

# --- LLM "Reason for Trade" (optional; off by default) ---
# When enabled, validated model text replaces the template reason. The model only
# ever sees engine-computed numbers — never notes, ids or account data.
# Provider-neutral: any OpenAI-compatible /chat/completions endpoint.
LLM_REASON_ENABLED=false
# e.g. Ollama cloud, OpenAI, Groq, OpenRouter, or a local Ollama server.
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Model id for the provider above (e.g. "llama3.3", "gpt-4o-mini").
LLM_REASON_MODEL=gpt-4o-mini
