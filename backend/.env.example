# Definedge Securities API credentials
DEFINEDGE_API_TOKEN=
DEFINEDGE_API_SECRET=
# External TOTP secret (enable at https://myaccount.definedgesecurities.com/security).
# When set, login bypasses the manual OTP prompt/endpoint and generates the
# 6-digit code from this secret instead.
DEFINEDGE_TOTP_SECRET=

# ClickHouse connection
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
# Required — docker-compose refuses to start without it. Use a long random value.
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=options_platform

# SQLite
SQLITE_PATH=./data/app.db

# Screener
NIFTY_MONEYNESS_BAND_PCT=15
SCREENER_INTERVAL_MINUTES=5

# --- str-stra screener (Definedge) ---
# Screens the 50-stock watchlist through the same Definedge Integrate
# connection the credit-spread screener uses. Signals are tagged
# data_source="live".
STR_STRA_ENABLED=true
STR_STRA_INTERVAL_MINUTES=10
# Daily-candle lookback used for ADX + candle indicators.
STR_STRA_HISTORY_DAYS=90
STR_STRA_ATM_PARITY_PCT=2.0

# --- Market breadth ---
# Advance/decline + %-above-DMA breadth computed in a background worker.
BREADTH_ENABLED=true
# "fno" (all F&O stocks) | "watchlist" (50-stock str-stra list) | explicit CSV.
BREADTH_UNIVERSE=fno
BREADTH_INTERVAL_MINUTES=15
BREADTH_DMA_PERIODS=20,50,200
BREADTH_DAILY_HISTORY_DAYS=400
# Intraday (hourly) breadth is expensive — opt-in.
BREADTH_INTRADAY_ENABLED=false

# --- Morning daily byte (Telegram via Telethon) ---
# Pulls the latest messages from configured channels/groups each morning and
# stores them (raw + LLM-structured) for display and later intelligence.
# Telethon reads message history, not just new messages.
TELEGRAM_ENABLED=false
# Get these from https://my.telegram.org (API development tools).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Telethon session file; first run does a one-time phone-code login.
TELEGRAM_SESSION_PATH=./data/telegram.session
# Optional StringSession override (instead of a .session file).
TELEGRAM_STRING_SESSION=
# Comma-separated channel/group usernames or ids to track.
TELEGRAM_DAILY_BYTE_CHATS=
TELEGRAM_DAILY_BYTE_HOUR=9
TELEGRAM_DAILY_BYTE_MINUTE=15
TELEGRAM_DAILY_BYTE_TIMEZONE=Asia/Kolkata
TELEGRAM_HISTORY_LOOKBACK_HOURS=12

# --- Daily byte LLM analysis (reuses LLM_API_KEY/LLM_API_BASE_URL) ---
LLM_BYTE_ENABLED=false
# Empty falls back to LLM_REASON_MODEL.
LLM_BYTE_MODEL=
LLM_BYTE_MAX_MESSAGES=20

# --- Security (see IMPLEMENTATION_PLAN.md) ---
# Static bearer token required on every API/WebSocket call. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=
# Fernet key used to encrypt broker session keys at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, session keys are NOT persisted (a restart triggers a fresh TOTP login).
SESSION_ENCRYPTION_KEY=
# Order placement is hard-disabled. Leave as 'disabled'.
TRADING_MODE=disabled
# Dev only: allow signals from the hardcoded sample chain when no live data exists.
ALLOW_SAMPLE_DATA=false

# --- LLM "Reason for Trade" (optional; off by default) ---
# When enabled, validated model text replaces the template reason. The model only
# ever sees engine-computed numbers — never notes, ids or account data.
# Provider-neutral: any OpenAI-compatible /chat/completions endpoint.
LLM_REASON_ENABLED=false
# e.g. Ollama cloud, OpenAI, Groq, OpenRouter, or a local Ollama server.
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Model id for the provider above (e.g. "llama3.3", "gpt-4o-mini").
LLM_REASON_MODEL=gpt-4o-mini
